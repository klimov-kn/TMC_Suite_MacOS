#TMC_RT_H
!  Plane wave scattering by the plasma sheath of a hypersonic vehicle.
!  Body: RAM C-II sphere-cone, R = 152.4 mm, half-angle 9 deg, L = 1295 mm,
!  perfectly conducting; H = 61 km, V = 7650 m/s, f = 0.4 GHz.
!  The wave travels along +X, the body axis lies at Y = Ysize/2.
!  Grid step 10 mm = lambda/75. The finest scale of the medium is the
!  shock layer, 22 mm thick at the stagnation point (2.2 cells).
!  Sheath permittivity is read from hyper_sheath_0p4.eps (stored values are eps-1);
!  eps-prime ranges from -4795.6 to 1. Generated by make_tamic_task.py.

#define W_name  @ hyper_sheath_0p4
#define W_freq  @ ( 0.4 )
#define W_delta @ ( 10 )
#define W_time  @ ( 250 )
#define Xsize   @ ( 15000 )
#define Ysize   @ ( 8000 )
#define W_type  @ MAGNETIC
#define a1      @ ( Ysize - 12*W_delta )

#STEP

#PARM
 ANGLE_UNIT radian;
 FREQ_UNIT GHz;
 LONG_UNIT mm;
 TIME_UNIT ns;
 DELTA W_delta;
 TIME 0.; W_time;
 X_MIN 0.0;
 X_MAX Xsize;
 Y_MIN 0.0;
 Y_MAX Ysize;
