# ============================================================
#  TMC Suite - .gitattributes
# ============================================================
# The C++ sources keep the line endings of the Windows edition (CRLF).
# Line-ending normalisation is disabled repository-wide so that every file
# round-trips byte for byte, exactly as it was compiled and tested.

* -text

# --- Explicitly binary: never diff or merge as text ---
*.png   binary
*.jpg   binary
*.bmp   binary
*.ico   binary
*.exe   binary
*.lib   binary
*.pdf   binary
*.docx  binary
*.doc   binary
*.suo   binary
*.opt   binary
*.mdp   binary
*.ncb   binary
*.sdf   binary

*.icns  binary
*.ttf   binary
*.step  binary
*.stl   binary
*.woff2 binary

# --- Generated artefacts: keep out of diffs and language stats ---

# --- Documentation should not skew the language breakdown ---
docs/**  linguist-documentation
