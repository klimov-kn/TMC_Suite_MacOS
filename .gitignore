# ============================================================
#  TMC Suite for macOS - .gitignore
# ============================================================

# --- Build output ---
/build/obj*/
/build/out-*/
/build/*.log

# --- Binaries: distributed via GitHub Releases, not committed ---
/dist/*
!/dist/README.md
*.o
*.a
*.dylib
*.app/
*.dmg

# --- Python helpers ---
__pycache__/
*.pyc

# --- Archives / temporary dumps ---
*.zip
*.7z
*.tar.gz

# --- Editor / OS junk ---
.DS_Store
.vscode/
*.user
*~
*.bak
*.orig
*.tmp
*.log
